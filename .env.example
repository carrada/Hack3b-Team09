LLM_PROVIDER=ollama          # ollama (local) | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_MODEL=qwen2.5vl:3b    # debe tener visión: lee los escaneos y también corre los agentes
# OLLAMA_VISION_MODEL=       # opcional: otro modelo solo para leer escaneos
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_GPU=99            # todas las capas en GPU (vacío = que Ollama decida)
OLLAMA_KEEP_ALIVE=30m
FILA_OLLAMA=1                # análisis locales simultáneos (1 en GPU de 4 GB; más = todos más lentos)
FILA_OPENAI=4                # análisis simultáneos en la nube
