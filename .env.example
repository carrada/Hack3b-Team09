# openai | ollama | ollama_cloud
LLM_PROVIDER=ollama

# OpenAI (solo si LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ollama local (LLM_PROVIDER=ollama). qwen2.5 no está en la nube de Ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# Ollama Cloud (LLM_PROVIDER=ollama_cloud). Clave en https://ollama.com/settings/keys
# Modelos cloud: gemma4:31b, gpt-oss:20b, etc. (no qwen2.5)
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gemma4:31b

# Linux: /usr/bin/tesseract · macOS brew: /opt/homebrew/bin/tesseract
# Windows: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
OCR_MOTOR=tesseract        # tesseract (sin IA) | vision (LLM)
